    {
      "name": "Get repos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Expected new repo name is in the list\", function () {\r",
              "    const repos = pm.response.json();\r",
              "    const found = repos.some(r => r.name === (pm.variables.get(\"repo\")));\r",
              "    pm.expect(found).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"New repo exists and is private\", function () {\r",
              "    const repos = pm.response.json();\r",
              "    const match = repos.find(r => r.name === (pm.variables.get(\"repo\")));\r",
              "    pm.expect(match).to.exist;\r",
              "    pm.expect(match.private).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
