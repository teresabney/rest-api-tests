    {
      "name": "Create repo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Repository name created\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.name).to.eql(pm.variables.get(\"repo\"));\r\n});\r\n\r\npm.test(\"Repository created as private\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.private).to.eql(true);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"name\": \"{{repo}}\",\r\n    \"description\": \"To demonstrate Full Stack QA knowledge of APIs, Postman, Automated API tests, and CI/CD integration\",\r\n    \"private\": true\r\n}",
